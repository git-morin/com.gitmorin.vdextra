<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <queries>
    <package android:name="VirtualDesktop.Quest" />
    <package android:name="VirtualDesktop.Android" />
  </queries>
  <application
      android:label="@string/app_name"
      android:description="@string/app_description"
      android:icon="@drawable/ic_launcher"
      android:theme="@style/Theme.VDExtra">
    <provider
        android:name="io.github.libxposed.service.XposedProvider"
        android:authorities="com.gitmorin.vdextra.XposedService"
        android:exported="true" />
    <provider
        android:name=".MusicProvider"
        android:authorities="com.gitmorin.vdextra.music"
        android:exported="true" />
    <receiver
        android:name=".MusicMissingReceiver"
        android:exported="true">
      <intent-filter>
        <action android:name="com.gitmorin.vdextra.MUSIC_MISSING" />
      </intent-filter>
    </receiver>
    <receiver
        android:name=".UpdateCheckReceiver"
        android:exported="true">
      <intent-filter>
        <action android:name="com.gitmorin.vdextra.CHECK_FOR_UPDATE" />
      </intent-filter>
    </receiver>
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:label="@string/app_name">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>